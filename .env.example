DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME

PGSSLROOTCERT=C:\path\to\postgresql-ca.pem

# --- Bright Data Scraping Browser (opcional) ---
# Si se define, la API y la consulta CLI usaran el navegador en la nube de
# Bright Data en lugar del Chromium local. Resuelve Cloudflare Turnstile
# automaticamente. Obtener la URL completa con credenciales desde:
# https://brightdata.es/cp/web_access/<zona>/edit
BRD_SBR_ENDPOINT=wss://brd-customer-hl_XXXXXXXX-zone-scraping_browser1:PASSWORD@brd.superproxy.io:9222
